# Local development secrets — copy this file to .dev.vars and fill in your keys.
# .dev.vars is git-ignored. NEVER commit real keys.
# After copying, add at least one key per section you want to enable.

# ── Tier 1: Commercial LLMs ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...
PERPLEXITY_API_KEY=pplx-...
TOGETHER_API_KEY=...
FIREWORKS_API_KEY=fw_...
OPENROUTER_API_KEY=sk-or-...

# ── HuggingFace Serverless Inference API (runs 20+ models on HF cloud) ───────
# Get your token at: https://huggingface.co/settings/tokens
# One key unlocks all HF · models in the UI
HF_API_KEY=hf_...

# ── Additional AI providers ───────────────────────────────────────────────────
BYTEZ_AI_KEY=...
OXLO_AI_KEY=sk_...
LONGCAT_API_KEY=ak_...

# ── Utility APIs (not chat providers — available for future features) ─────────
GOOGLE_API_KEY=AIza...
OPENWEATHER_API_KEY=...
WEATHER_API_KEY=...
GOOGLE_SEARCH_API_KEY=...
SEARCH_ENGINE_ID=...

# ── LiveKit (voice/video) ─────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=...
